# ==========================================
# Students Hub — Variáveis de Ambiente
# ==========================================

# 1. CLIENT SAFE (Expostas no bundle frontend com prefixo VITE_)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# Domínio técnico usado para transformar "nome" em email interno do Supabase Auth
# (ex.: "João Silva" -> joao.silva@students-hub.app). Nunca é usado para enviar emails.
# Se o Supabase rejeitar o domínio, usa um domínio teu com registos MX.
VITE_AUTH_EMAIL_DOMAIN="students-hub.app"
VITE_APP_NAME="Students Hub"
VITE_APP_SLOGAN="Apontamentos que ajudam, exercícios que resultam. Rumo ao 20."

# 2. SERVER ONLY / NETLIFY FUNCTIONS ONLY (NUNCA expor no frontend!)
# Modelo Gemini obrigatório sem hardcoding arbitrário
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Limites de custo/latência do Gemini (opcionais; valores por omissão abaixo)
GEMINI_TIMEOUT_MS="18000"        # as Netlify Functions têm timeout de 26 s
GEMINI_MAX_NOTE_CHARS="60000"    # texto oficial máximo enviado ao Gemini por pedido

# Apenas verificação de papéis (auth-check) e admin-notes. As funções de exercícios e
# sessões usam o token do próprio utilizador + anon key (sem service role).
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Netlify App URL
APP_URL="MY_APP_URL"
